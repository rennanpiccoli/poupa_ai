{
  "name": "super_mkt_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/shared/db/migrate.ts",
    "collect": "tsx --env-file-if-exists=.env src/collector/index.ts",
    "build:jobs": "esbuild src/collector/index.ts src/shared/db/migrate.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --alias:@=./src --banner:js=\"import{createRequire}from\\\"module\\\";const require=createRequire(import.meta.url);\"",
    "fixtures": "tsx scripts/fetch-fixtures.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "domhandler": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
