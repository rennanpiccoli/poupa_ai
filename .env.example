# Copy to .env and fill. Never commit .env.
# Local dev (next dev on the host):
DATABASE_URL=postgres://app:app@localhost:5432/supermkt
# Inside docker compose (VPS) the host is the service name:
# DATABASE_URL=postgres://app:<password>@db:5432/supermkt
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=supermkt
# VPS only: image in GHCR (lowercase), e.g. ghcr.io/<owner>/super_mkt_app
# IMAGE=
